@startuml
title Domænemodel for personaleplanlægning
hide circle
hide empty members

class Medarbejder {
    navn
}

class Vagt {
    vagtId
    dato
    starttid
    sluttid
}

class Rolle {
    navn
}

class Rådighedsperiode {
    dato
