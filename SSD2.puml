
@startuml
title SSD - Skift medarbejder på en vagt

hide footbox
autoactivate off

skinparam backgroundColor white

skinparam ActorStyle stickman
skinparam ActorBackgroundColor white
skinparam ActorBorderColor black
skinparam ActorFontColor black

skinparam ParticipantBackgroundColor white
skinparam ParticipantBorderColor black
skinparam ParticipantFontColor black

skinparam SequenceLifeLineBackgroundColor white
skinparam SequenceLifeLineBorderColor black

skinparam ArrowColor black
skinparam ArrowFontColor black

skinparam GroupBorderColor black
skinparam GroupBackgroundColor white
skinparam GroupHeaderFontColor black
skinparam GroupBodyBackgroundColor white

actor "Hotelmanager" as H
participant ": System" as S

H -> S : seVagter()
S --> H : vagtListe

H -> S : vælgVagt(V04)
S --> H : vagtDetaljer

H -> S : skiftMedarbejder(V04, medarbejder)

alt Emil vælges (gyldig)
    S --> H : bekræftelse(V04, Emil)

else Sara vælges (overlappende vagt)
    S --> H : fejlbesked("Overlappende vagt")

else Ida vælges (forkert rolle)
    S --> H : fejlbesked("Forkert rolle")
end

@enduml
